# Contact form configuration.
#
# Local development: copy this to .env.local (gitignored) and fill it in.
# Vercel: set these as project environment variables, Settings ->
#   Environment Variables, for Production, Preview and Development.
# Azure Static Web Apps: the two server-side values below are set as
#   Application Settings on the Static Web App resource instead (the Azure
#   Function reads them from there), and the site key is passed into the build.

# Selects the deploy target. Leave unset for Azure, which produces the static
# export in out/ that azure-pipelines.yml deploys. Set to "vercel" on Vercel so
# the export is skipped and app/api/contact/route.js runs as a real endpoint,
# without which /api/contact is a 404 there.
BUILD_TARGET=

# reCAPTCHA v2 "I'm not a robot" Checkbox site key. Public by design, and
# inlined into the client bundle at BUILD time because of the NEXT_PUBLIC_
# prefix, so changing it needs a rebuild and redeploy, not just a restart.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# reCAPTCHA secret key. Server-side only, used to verify the client's token
# with Google. Never exposed to the browser.
RECAPTCHA_SECRET_KEY=

# Power Automate "When an HTTP request is received" POST URL. Treat as a
# secret: the URL itself embeds the signature that authorises the call.
CONTACT_FLOW_URL=
